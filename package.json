{
  "name": "easycode",
  "version": "0.0.0",
  "private": true,
  "description": "中文优先、可解释、可验证的轻量 Coding Agent",
  "type": "module",
  "bin": {
    "easycode": "./dist/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests evals",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:smoke": "vitest run tests/smoke/openai-compatible.smoke.test.ts",
    "eval:build": "tsc -p tsconfig.eval.json",
    "eval:offline": "npm run eval:build --silent && node .easycode/eval-dist/evals/cli/offline.js",
    "eval:real": "npm run eval:build --silent && node .easycode/eval-dist/evals/cli/real.js",
    "check": "tsc --noEmit && biome check src tests evals && vitest run && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "ink": "7.1.1",
    "react": "19.2.8"
  }
}
