{
  "name": "easycode",
  "version": "0.0.0",
  "private": true,
  "description": "中文优先、可解释、可验证的轻量 Coding Agent",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "test": "vitest run",
    "check": "tsc --noEmit && biome check src tests && vitest run && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
